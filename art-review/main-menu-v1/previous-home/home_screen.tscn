[gd_scene load_steps=4 format=3]
[ext_resource type="Script" path="../scripts/home_screen.gd" id="1"]
[ext_resource type="Theme" path="../themes/pocket_armor.tres" id="2"]
[ext_resource type="Script" path="../scripts/tank_display.gd" id="3"]

[node name="HomeScreen" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2")
script = ExtResource("1")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
theme_override_constants/margin_left = 70
theme_override_constants/margin_right = 70
theme_override_constants/margin_top = 60
theme_override_constants/margin_bottom = 60

[node name="Scroll" type="ScrollContainer" parent="Margin"]
layout_mode = 2
horizontal_scroll_mode = 0

[node name="Layout" type="BoxContainer" parent="Margin/Scroll"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
theme_override_constants/separation = 24

[node name="Menu" type="VBoxContainer" parent="Margin/Scroll/Layout"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 4
theme_override_constants/separation = 20

[node name="Kicker" type="Label" parent="Margin/Scroll/Layout/Menu"]
layout_mode = 2
theme_override_colors/font_color = Color(0.50, 0.73, 0.68, 1)
theme_override_font_sizes/font_size = 13
text = "TABLETOP COMBAT / EST. TINY"

[node name="Title" type="Label" parent="Margin/Scroll/Layout/Menu"]
layout_mode = 2
theme_override_font_sizes/font_size = 88
text = "POCKET\nARMOR"

[node name="Tagline" type="Label" parent="Margin/Scroll/Layout/Menu"]
layout_mode = 2
theme_override_font_sizes/font_size = 18
text = "Small tanks. Big trouble."

[node name="Actions" type="VBoxContainer" parent="Margin/Scroll/Layout/Menu"]
layout_mode = 2
theme_override_constants/separation = 14

[node name="Play" type="Button" parent="Margin/Scroll/Layout/Menu/Actions"]
layout_mode = 2
custom_minimum_size = Vector2(0, 64)
theme_type_variation = &"PrimaryButton"
text = "PLAY  →"

[node name="Settings" type="Button" parent="Margin/Scroll/Layout/Menu/Actions"]
layout_mode = 2
custom_minimum_size = Vector2(0, 54)
text = "Settings"

[node name="Quit" type="Button" parent="Margin/Scroll/Layout/Menu/Actions"]
layout_mode = 2
custom_minimum_size = Vector2(0, 54)
text = "Quit game"

[node name="Footer" type="Label" parent="Margin/Scroll/Layout/Menu"]
layout_mode = 2
theme_override_colors/font_color = Color(0.64, 0.72, 0.76, 1)
theme_override_font_sizes/font_size = 12
text = "8 TANKS     /     6 ARENAS     /     ONE SURVIVOR"
autowrap_mode = 2

[node name="Display" type="VBoxContainer" parent="Margin/Scroll/Layout"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_stretch_ratio = 1.3
custom_minimum_size = Vector2(0, 420)

[node name="Tank" type="SubViewportContainer" parent="Margin/Scroll/Layout/Display"]
layout_mode = 2
size_flags_vertical = 3
custom_minimum_size = Vector2(0, 250)
stretch = true
mouse_filter = 2
script = ExtResource("3")

[node name="Caption" type="Label" parent="Margin/Scroll/Layout/Display"]
layout_mode = 2
theme_override_font_sizes/font_size = 14
text = "01 / AZURE SCOUT"
horizontal_alignment = 1

[node name="Subtitle" type="Label" parent="Margin/Scroll/Layout/Display"]
layout_mode = 2
theme_override_colors/font_color = Color(0.64, 0.72, 0.76, 1)
theme_override_font_sizes/font_size = 12
text = "PICK YOUR TANK. MAKE YOUR MARK."
horizontal_alignment = 1
