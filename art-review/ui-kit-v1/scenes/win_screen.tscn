[gd_scene load_steps=4 format=3]

[ext_resource type="Theme" path="../themes/pocket_armor.tres" id="1_theme"]
[ext_resource type="Script" path="../scripts/menu_screen.gd" id="2_script"]
[ext_resource type="Texture2D" path="../icons/cup.svg" id="3_emblem"]

[node name="WinScreen" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("1_theme")
script = ExtResource("2_script")
screen_kind = "win_screen"

[node name="Dimmer" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.055, 0.10, 0.085, 0.72)
mouse_filter = 0

[node name="SafeArea" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 20
theme_override_constants/margin_top = 20
theme_override_constants/margin_right = 20
theme_override_constants/margin_bottom = 20

[node name="Scroll" type="ScrollContainer" parent="SafeArea"]
layout_mode = 2
horizontal_scroll_mode = 0

[node name="Center" type="CenterContainer" parent="SafeArea/Scroll"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3

[node name="Card" type="PanelContainer" parent="SafeArea/Scroll/Center"]
custom_minimum_size = Vector2(440, 0)
layout_mode = 2

[node name="Stack" type="VBoxContainer" parent="SafeArea/Scroll/Center/Card"]
layout_mode = 2
theme_override_constants/separation = 14

[node name="Emblem" type="TextureRect" parent="SafeArea/Scroll/Center/Card/Stack"]
custom_minimum_size = Vector2(72, 72)
layout_mode = 2
size_flags_horizontal = 4
texture = ExtResource("3_emblem")
expand_mode = 1
stretch_mode = 5

[node name="Kicker" type="Label" parent="SafeArea/Scroll/Center/Card/Stack"]
layout_mode = 2
theme_override_font_sizes/font_size = 12
text = "TINY TANK. BIG ENERGY."
horizontal_alignment = 1

[node name="Title" type="Label" parent="SafeArea/Scroll/Center/Card/Stack"]
layout_mode = 2
theme_override_font_sizes/font_size = 48
text = "BIG VICTORY!"
horizontal_alignment = 1

[node name="Description" type="Label" parent="SafeArea/Scroll/Center/Card/Stack"]
layout_mode = 2
theme_override_font_sizes/font_size = 16
text = "You owned your corner of the table."
horizontal_alignment = 1
autowrap_mode = 2

[node name="Stats" type="HBoxContainer" parent="SafeArea/Scroll/Center/Card/Stack"]
layout_mode = 2
alignment = 1
