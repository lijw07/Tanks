[node name="Score" type="Label" parent="SafeArea/Scroll/Center/Card/Stack/Stats"]
layout_mode = 2
text = "07\nTARGETS CLEARED"
horizontal_alignment = 1

[node name="Armor" type="Label" parent="SafeArea/Scroll/Center/Card/Stack/Stats"]
layout_mode = 2
text = "3 / 3\nHULL HP"
horizontal_alignment = 1

[node name="Again" type="Button" parent="SafeArea/Scroll/Center/Card/Stack"]
